# ============================================================
# PLANTILLA DE CONFIGURACIÓN - COPIA ESTE ARCHIVO COMO .env
# ============================================================
# Este proyecto usa Supabase LOCAL (Docker) para desarrollo.
# No pongas credenciales de producción acá.
#
# Pasos:
#   1. Copia este archivo como .env
#   2. Levanta el stack local:  npm run supabase:start
#   3. Copia el ANON_KEY local generado a VITE_SUPABASE_ANON_KEY:
#        npm run supabase:status -o env
#   4. Ejecuta la app:  npm run dev
#
# La anon key es DIFERENTE en cada máquina (la genera supabase start).
# Nunca uses la anon key de producción en desarrollo.

# ------------------------------------------------------------
# Supabase local API (Docker)
# ------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=reemplazar-por-el-ANON_KEY-local-de-tu-maquina

# ------------------------------------------------------------
# Puertos locales de los servicios Supabase (Docker)
# ------------------------------------------------------------
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_STUDIO_PORT=54323
SUPABASE_MAILPIT_PORT=54324
SUPABASE_SMTP_PORT=54325
SUPABASE_POP3_PORT=54326

# ------------------------------------------------------------
# Secretos de servidor (Edge Functions / scripts). No exponer en el frontend.
# En local los genera supabase start; no uses los de producción.
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=reemplazar-por-el-SERVICE_ROLE_KEY-local
CRON_SECRET=tu-cron-secret-local
